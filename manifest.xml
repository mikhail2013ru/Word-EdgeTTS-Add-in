<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp 
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">
  
  <!-- Генерация корректного GUID (используйте https://guidgenerator.com/) -->
  <Id>3a12b8d4-5e6f-4a7b-9c8d-1e2f3a4b5c6d</Id>
  <Version>1.0.0</Version>
  <ProviderName>Your Company</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Edge TTS"/>
  <Description DefaultValue="Синтез речи через Edge TTS"/>
  <SupportUrl DefaultValue="https://yourdomain.com/support"/>

  <!-- Обязательный порядок элементов -->
  <Hosts>
    <Host Name="Document"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="WordApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <!-- Иконка теперь в DefaultSettings -->
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
    <IconUrl DefaultValue="https://yourdomain.com/assets/icon-64.png"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <Runtimes>
          <Runtime resid="TaskPane.Url" lifetime="long"/>
        </Runtimes>
        
        <AllowedDomains>
          <Domain>https://localhost:5000</Domain>
          <Domain>https://yourdomain.com</Domain>
        </AllowedDomains>
        
        <ExtensionPoint xsi:type="ContextMenu">
          <OfficeMenu id="ContextMenuText">
            <Control xsi:type="Button" id="EdgeTTSButton">
              <Label resid="EdgeTTS.Label"/>
              <Supertip>
                <Title resid="EdgeTTS.Title"/>
                <Description resid="EdgeTTS.Desc"/>
              </Supertip>
              <Icon>
                <bt:Image size="16" resid="Icon.16x16"/>
                <bt:Image size="32" resid="Icon.32x32"/>
                <bt:Image size="80" resid="Icon.80x80"/>
              </Icon>
              <Action xsi:type="ExecuteFunction">
                <FunctionName>synthesizeSpeech</FunctionName>
              </Action>
            </Control>
          </OfficeMenu>
        </ExtensionPoint>
      </Host>
    </Hosts>
    
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://yourdomain.com/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://yourdomain.com/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://yourdomain.com/assets/icon-80.png"/>
      </bt:Images>
      <bt:ShortStrings>
        <bt:String id="EdgeTTS.Label" DefaultValue="Синтезировать речь"/>
        <bt:String id="EdgeTTS.Title" DefaultValue="Edge TTS"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="EdgeTTS.Desc" DefaultValue="Преобразует выделенный текст в речь"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>